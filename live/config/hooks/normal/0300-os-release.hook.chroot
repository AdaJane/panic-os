#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Make the image identify itself as PanicOS, not as Debian.
#
# /etc/os-release belongs to Debian's base-files package. It is diverted, so
# that an upgrade of base-files on a persistent stick puts Debian's file
# aside (as /etc/os-release.debian) instead of putting it back, and replaced
# by a link to PanicOS's own os-release, which the build generates.
#
# live-build diverts the same file for the duration of the build and drops
# its diversion afterwards, which would leave the next base-files upgrade
# free to restore Debian's. Its diversion is replaced by ours here; with it
# gone, live-build's later clean-up finds nothing to undo.

set -eu

# shellcheck source=live/config/includes.chroot/usr/lib/panicos/constants.sh
. /usr/lib/panicos/constants.sh

readonly OS_RELEASE=/etc/os-release
readonly DEBIAN_OS_RELEASE=/etc/os-release.debian

# --no-rename throughout: the file in place is replaced below, not moved.
dpkg-divert --quiet --local --no-rename --remove "${OS_RELEASE}"
dpkg-divert --quiet --local --no-rename --divert "${DEBIAN_OS_RELEASE}" --add "${OS_RELEASE}"
rm -f "${OS_RELEASE}"
# A relative link, as Debian's own is: live-build reads this file from outside
# the chroot (for the version on the boot splash), where an absolute target
# would point into the build host instead.
ln --symbolic --relative "${PANICOS_OS_RELEASE_SOURCE}" "${OS_RELEASE}"

# Fail the build unless the result reads back as PanicOS, stays diverted, and
# is a relative link.
# shellcheck source=/dev/null  # generated by the build
[ "$(. "${OS_RELEASE}" && echo "${ID}")" = "${PANICOS_OS_ID}" ]
dpkg-divert --list "${OS_RELEASE}" | grep --quiet --fixed-strings "${DEBIAN_OS_RELEASE}"
case "$(readlink "${OS_RELEASE}")" in
	/*) echo "${OS_RELEASE} is an absolute link" >&2; exit 1 ;;
esac
