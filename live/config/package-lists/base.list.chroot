# SPDX-License-Identifier: MIT
# Packages that ship no binary for panicos-selftest to probe. Anything with a
# binary belongs in manifest/tools.tsv instead.
#
# Recommends are off (see auto/config) to keep the image small, so nothing
# arrives by implication: a package another one merely "recommends" has to be
# named here if PanicOS needs it. Several below are exactly that.

# --- Live system -------------------------------------------------------------
# Recommended by live-config, which silently skips creating the live user
# without user-setup, and setting the locale and keyboard without the others.
user-setup
locales
keyboard-configuration
console-setup
kbd
# Puts cryptsetup and its passphrase prompt in the initramfs, so live-boot can
# unlock an encrypted persistence volume.
cryptsetup-initramfs
# A wrong clock (dead CMOS battery) breaks TLS, and so Claude Code and apt.
systemd-timesyncd
libnss-systemd
sudo

# --- Hardware support --------------------------------------------------------
# Chosen by hand rather than with live-build's --firmware-chroot, which pulls
# in every firmware package in the archive.
amd64-microcode
intel-microcode
firmware-linux-free
firmware-misc-nonfree
firmware-intel-misc
# Without their firmware the amdgpu and i915 drivers can leave a blank screen.
firmware-amd-graphics
firmware-intel-graphics
# Wi-Fi and wired NICs: Claude Code and network offload need a connection.
firmware-atheros
firmware-brcm80211
firmware-iwlwifi
firmware-mediatek
firmware-realtek
wireless-regdb

# --- Desktop -----------------------------------------------------------------
# No display manager: live-config logs the user in on tty1 and, because xinit
# is installed, starts X from there. If X cannot start, the console remains.
xserver-xorg-core
xserver-xorg-input-libinput
# Fallbacks for when kernel mode setting fails and the operator boots with
# "nomodeset".
xserver-xorg-video-fbdev
xserver-xorg-video-vesa
x11-xserver-utils
xfce4
dbus-user-session
fonts-dejavu-core
# SVG support for GTK, without which most icons are blank.
librsvg2-common

# --- Development -------------------------------------------------------------
build-essential
pkg-config
python3-dev
python3-venv
manpages
manpages-dev

# --- Base system comforts ----------------------------------------------------
bash-completion
ca-certificates
man-db
