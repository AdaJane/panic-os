#!/bin/bash
# SPDX-License-Identifier: MIT
#
# panicos-status — say what this stick is and whether it is keeping state.
#
# usage: panicos-status
#
# Emits:  the release; one line on persistence; one line on Claude Code. If
#         persistence was wanted but is missing, also what that means and
#         how to fix it.
# Exit:   0 if state is being kept, or the operator chose a boot entry that
#         keeps none; 1 if persistence is missing.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly LIB_DIR="$SCRIPT_DIR/../lib/panicos"
# shellcheck source=live/config/includes.chroot/usr/lib/panicos/constants.sh
source "$LIB_DIR/constants.sh"
# shellcheck source=live/config/includes.chroot/usr/lib/panicos/persistence.sh
source "$LIB_DIR/persistence.sh"
# shellcheck source=live/config/includes.chroot/usr/lib/panicos/claude.sh
source "$LIB_DIR/claude.sh"

readonly EX_NOT_PERSISTENT=1
readonly OS_RELEASE=/etc/os-release

release() (
  # shellcheck source=/dev/null  # generated by the build
  source "$OS_RELEASE"
  printf '%s\n' "$PRETTY_NAME"
)

claude_line() {
  if [[ "$(claude_installed)" == "$PANICOS_YES" ]]; then
    printf 'Claude Code: installed\n'
  else
    printf 'Claude Code: not installed (to install it: panicos-install-claude)\n'
  fi
}

release
claude_line

state="$(current_persistence_state)"
readonly state
case $state in
  "$PANICOS_PERSISTENCE_ACTIVE")
    printf 'persistence: active\n'
    ;;
  "$PANICOS_PERSISTENCE_DISABLED")
    printf 'persistence: off for this boot, as chosen in the boot menu\n'
    ;;
  "$PANICOS_PERSISTENCE_MISSING")
    cat << 'END'
persistence: MISSING

  This stick has no persistence volume. Nothing you change, save or sign in
  to will survive a reboot: not Wi-Fi passwords, not notes, not installed
  packages, not a Claude Code install or login.

  Add one from the machine that built the image, with the stick plugged in:

      make persist DEVICE=/dev/sdX
END
    exit "$EX_NOT_PERSISTENT"
    ;;
esac
