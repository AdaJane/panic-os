#!/bin/bash
# SPDX-License-Identifier: MIT
#
# selftest-report — report boot facts and the self-test verdict to the VM
# test harness. Run by panicos-selftest.service, whose stdout and stderr are
# the first serial port. Protocol: see constants.sh.
#
# Exit: 0 if the self-test passed, 1 otherwise.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
# shellcheck source=live/config/includes.chroot/usr/lib/panicos/constants.sh
source "$SCRIPT_DIR/constants.sh"
# shellcheck source=live/config/includes.chroot/usr/lib/panicos/persistence.sh
source "$SCRIPT_DIR/persistence.sh"

# One line is appended per run. Without persistence this file lives in RAM
# and never holds more than the current boot.
readonly BOOT_LOG=/var/lib/panicos/selftest-boots

readonly WINDOW_MANAGER=xfwm4
readonly DESKTOP_WAIT_SECONDS=90

readonly EFI_DIR=/sys/firmware/efi
# EFI global variable SecureBoot: four attribute bytes, then one value byte.
readonly SECUREBOOT_VAR="$EFI_DIR/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c"
readonly EFI_ATTRIBUTE_BYTES=4

firmware() {
  if [[ -d $EFI_DIR ]]; then
    printf '%s\n' "$PANICOS_FIRMWARE_UEFI"
  else
    printf '%s\n' "$PANICOS_FIRMWARE_BIOS"
  fi
}

# secureboot -> 1 if the firmware is enforcing Secure Boot, else 0.
secureboot() {
  if [[ -r $SECUREBOOT_VAR ]]; then
    od --address-radix=n --format=u1 --skip-bytes="$EFI_ATTRIBUTE_BYTES" \
      --read-bytes=1 "$SECUREBOOT_VAR" | tr -d ' \n'
    printf '\n'
  else
    printf '0\n'
  fi
}

# desktop_flag -> 1 once the window manager is running, 0 if it has not
# appeared in time. This unit starts before the automatic login on tty1 has
# brought X up, hence the wait.
desktop_flag() {
  if timeout "$DESKTOP_WAIT_SECONDS" \
    bash -c 'until pgrep --exact "$0" > /dev/null; do sleep 1; done' "$WINDOW_MANAGER"; then
    printf '1\n'
  else
    printf '0\n'
  fi
}

# pkexec_flag -> 1 if the user running the desktop can become root through
# polkit without being asked anything, else 0 (also when no desktop is up).
pkexec_flag() {
  local desktop_user
  desktop_user="$(ps --no-headers -o user:32 -C "$WINDOW_MANAGER" | head --lines=1 | tr -d ' ')"
  readonly desktop_user
  if [[ -n $desktop_user ]] \
    && runuser --user "$desktop_user" -- pkexec true < /dev/null > /dev/null 2>&1; then
    printf '1\n'
  else
    printf '0\n'
  fi
}

# os_id -> the ID this system gives in os-release.
os_id() (
  # shellcheck source=/dev/null  # generated by the build
  source /etc/os-release
  printf '%s\n' "$ID"
)

active_swaps() {
  swapon --noheadings --show=NAME | wc --lines
}

# foreign_mounts -> how many mounted block devices are neither the live
# medium nor a persistence volume. Loop devices are the image's own squashfs.
foreign_mounts() {
  findmnt --real --noheadings --list --output SOURCE,TARGET \
    | awk -v medium="$PANICOS_LIVE_MEDIUM_MOUNT" -v persistence="$PANICOS_PERSISTENCE_MOUNT_DIR/" '
        $1 ~ "^/dev/" && $1 !~ "^/dev/loop" && $2 != medium && index($2, persistence) != 1
      ' \
    | wc --lines
}

# block_devices GLOB -> how many block devices have a name matching GLOB.
block_devices() {
  find /sys/block -maxdepth 1 -name "$1" | wc --lines
}


# record_boot -> the number of self-test runs recorded on this system's disk,
# including this one.
record_boot() {
  mkdir -p "$(dirname "$BOOT_LOG")"
  date --utc --iso-8601=seconds >> "$BOOT_LOG"
  sync --file-system "$BOOT_LOG"
  wc --lines < "$BOOT_LOG"
}

printf '%s firmware=%s secureboot=%s\n' "$PANICOS_MARK_BOOT" "$(firmware)" "$(secureboot)"
printf '%s id=%s\n' "$PANICOS_MARK_IDENTITY" "$(os_id)"
printf '%s state=%s boots=%s\n' "$PANICOS_MARK_PERSISTENCE" "$(current_persistence_state)" "$(record_boot)"
printf '%s running=%s pkexec=%s\n' "$PANICOS_MARK_DESKTOP" "$(desktop_flag)" "$(pkexec_flag)"
# After the desktop is up, so that anything it would mount has been mounted.
printf '%s swaps=%s foreign_mounts=%s md_arrays=%s dm_devices=%s\n' "$PANICOS_MARK_SAFETY" \
  "$(active_swaps)" "$(foreign_mounts)" "$(block_devices 'md*')" "$(block_devices 'dm-*')"

if "$SCRIPT_DIR/../../bin/panicos-selftest"; then
  printf '%s\n' "$PANICOS_MARK_PASS"
else
  printf '%s\n' "$PANICOS_MARK_FAIL"
  exit 1
fi
